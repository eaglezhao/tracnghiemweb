        <rdfs:subClassOf rdf:resource="#Na"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasFormula"/>
                <owl:hasValue rdf:datatype="&xsd;string">Na +</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ne -->

    <owl:Class rdf:about="#Ne">
        <rdfs:label xml:lang="en">Neon</rdfs:label>
        <rdfs:subClassOf rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ni -->

    <owl:Class rdf:about="#Ni">
        <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ni_2plus -->

    <owl:Class rdf:about="#Ni_2plus">
        <rdfs:subClassOf rdf:resource="#MonoatomicCation"/>
        <rdfs:subClassOf rdf:resource="#Ni"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasFormula"/>
                <owl:hasValue>Ni 2+</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Nitric_Acid -->

    <owl:Class rdf:about="#Nitric_Acid">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainIon"/>
                <owl:onClass rdf:resource="#NO3_1minus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainIon"/>
                <owl:onClass rdf:resource="#H_1plus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>HNO3</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#NobleGas -->

    <owl:Class rdf:about="#NobleGas">
        <rdfs:subClassOf rdf:resource="#NonMetal"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#NonMetal -->

    <owl:Class rdf:about="#NonMetal">
