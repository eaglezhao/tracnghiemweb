    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Metal -->

    <owl:Class rdf:about="#Metal">
        <rdfs:subClassOf rdf:resource="#Atom"/>
        <rdfs:comment rdf:datatype="&xsd;string"
            >AlkaliMetal or AlkalineEarthMetal or TransitionMetal or SemiMetal or Actinide or Lanthanide</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#MetalicIon -->

    <owl:Class rdf:about="#MetalicIon">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Ion"/>
                    <rdf:Description rdf:about="#Metal"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#MetalicOxide -->

    <owl:Class rdf:about="#MetalicOxide">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Oxide"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasComponent"/>
                        <owl:onClass rdf:resource="#Metal"/>
                        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="#Oxide"/>
    </owl:Class>
    


