            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainAtom"/>
                <owl:onClass rdf:resource="#H"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">4</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#SodiumChloride"/>
        <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
        <rdfs:comment rdf:datatype="&xsd;string">CH4</rdfs:comment>
    </owl:Class>
    


