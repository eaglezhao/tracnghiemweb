    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#OtherNonMetal -->

    <owl:Class rdf:about="#OtherNonMetal">
        <rdfs:subClassOf rdf:resource="#NonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Oxide -->

    <owl:Class rdf:about="#Oxide">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasComponent"/>
                        <owl:onClass rdf:resource="#O"/>
                        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasComponent"/>
                        <owl:onClass>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="#Atom"/>
                                    <owl:Class>
                                        <owl:complementOf rdf:resource="#O"/>
                                    </owl:Class>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:onClass>
                        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="#Compound"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Oxygen -->

    <owl:Class rdf:about="#Oxygen">
        <rdfs:label rdf:datatype="&xsd;string">Oxygen</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainAtom"/>
                <owl:onClass rdf:resource="#O"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">2</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasFormula"/>
                <owl:hasValue rdf:datatype="&xsd;string">O3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ozone -->

    <owl:Class rdf:about="#Ozone">
