    <owl:Class rdf:about="#Ion">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:comment xml:lang="chebi"
            >An ion is a molecular structure having a net electric charge</rdfs:comment>
        <rdfs:comment xml:lang="en"
            >An ion is an atom or molecule which has lost or gained one or more valence electrons, giving it a positive or negative electrical charge.</rdfs:comment>
    </owl:Class>
    


