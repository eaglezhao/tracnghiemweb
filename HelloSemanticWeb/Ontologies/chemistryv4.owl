    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#S_2minus -->

    <owl:Class rdf:about="#S_2minus">
        <rdfs:subClassOf rdf:resource="#AcidRadical"/>
        <rdfs:subClassOf rdf:resource="#MonoatomicAnion"/>
        <rdfs:subClassOf rdf:resource="#S"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasName"/>
                <owl:hasValue rdf:datatype="&xsd;string">Sulfide</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;integer">-2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Salt -->

    <owl:Class rdf:about="#Salt">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasComponent"/>
                        <owl:onClass rdf:resource="#AcidRadical"/>
                        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasComponent"/>
                        <owl:onClass>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="#MetalicIon"/>
                                    <rdf:Description rdf:about="#NH4_1plus"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:onClass>
                        <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="#Compound"/>
    </owl:Class>
    


