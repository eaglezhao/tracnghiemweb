    <owl:Class rdf:about="#SodiumChloride">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Cl_1minus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Na_1plus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
        <rdfs:comment rdf:datatype="&xsd;string">NaCl</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#SodiumHydroxide -->

    <owl:Class rdf:about="#SodiumHydroxide">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainIon"/>
                <owl:onClass rdf:resource="#Na_1plus"/>
