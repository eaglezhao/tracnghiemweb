        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#ContainAtom"/>
                <owl:onClass rdf:resource="#O"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">3</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#P -->

