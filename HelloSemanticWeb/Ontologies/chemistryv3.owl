    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#HydrogenChloride -->

    <owl:Class rdf:about="#HydrogenChloride">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#H_1plus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Cl_1minus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#Methan"/>
        <owl:disjointWith rdf:resource="#PyridylGlycol"/>
        <owl:disjointWith rdf:resource="#SodiumChloride"/>
        <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
        <owl:disjointWith rdf:resource="#Water"/>
        <rdfs:comment rdf:datatype="&xsd;string">HCl</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#I -->

    <owl:Class rdf:about="#I">
