    <owl:Class rdf:about="#Li_1plus">
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf rdf:resource="#Li"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Lipid -->

    <owl:Class rdf:about="#Lipid">
        <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#MetabolicProcess -->

    <owl:Class rdf:about="#MetabolicProcess">
        <rdfs:subClassOf rdf:resource="#BiologicalProcess"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Metal -->

    <owl:Class rdf:about="#Metal">
        <rdfs:subClassOf rdf:resource="#Atom"/>
        <owl:disjointWith rdf:resource="#NonMetal"/>
        <rdfs:comment rdf:datatype="&xsd;string"
            >AlkaliMetal or AlkalineEarthMetal or TransitionMetal or SemiMetal or Actinide or Lanthanide</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#MetalicIon -->

    <owl:Class rdf:about="#MetalicIon">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Ion"/>
                    <rdf:Description rdf:about="#Metal"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="#Cation"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Methan -->

    <owl:Class rdf:about="#Methan">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <owl:disjointWith rdf:resource="#PyridylGlycol"/>
        <owl:disjointWith rdf:resource="#SodiumChloride"/>
        <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
        <owl:disjointWith rdf:resource="#Water"/>
        <rdfs:comment rdf:datatype="&xsd;string">CH4</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Mg -->

    <owl:Class rdf:about="#Mg">
        <rdfs:label xml:lang="en">Magnesium</rdfs:label>
        <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Mg_2plus -->

    <owl:Class rdf:about="#Mg_2plus">
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf rdf:resource="#Mg"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Mn -->

    <owl:Class rdf:about="#Mn">
        <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Molecule -->

    <owl:Class rdf:about="#Molecule">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:comment xml:lang="chebi"
            >A molecule is an electrically neutral entity consisting of more than one atom.</rdfs:comment>
        <rdfs:comment xml:lang="wikipedia"
            >A molecule is a sufficiently stable electrically neutral group of at least two atoms in a definite arrangement held together by very strong chemical bonds . It can also be defined as a unit of two or more atoms held together by covalent bonds.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#MonoatomicIon -->

    <owl:Class rdf:about="#MonoatomicIon">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Atom"/>
                    <rdf:Description rdf:about="#Ion"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Monosaccharide -->

    <owl:Class rdf:about="#Monosaccharide">
        <rdfs:subClassOf rdf:resource="#Carbohydrate"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#N -->

    <owl:Class rdf:about="#N">
        <rdfs:label xml:lang="en">Nitrogen</rdfs:label>
        <rdfs:subClassOf rdf:resource="#OtherNonMetal"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberOfProtons"/>
                <owl:hasValue rdf:datatype="&xsd;integer">7</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#N_3minus -->

    <owl:Class rdf:about="#N_3minus">
        <rdfs:label xml:lang="en">Nitride</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Anion"/>
        <rdfs:subClassOf rdf:resource="#N"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">-3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Na -->

    <owl:Class rdf:about="#Na">
        <rdfs:label xml:lang="en">Sodium</rdfs:label>
        <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Na_1plus -->

    <owl:Class rdf:about="#Na_1plus">
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf rdf:resource="#Na"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">1</owl:hasValue>
            </owl:Restriction>
