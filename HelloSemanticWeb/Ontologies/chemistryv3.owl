        <rdfs:label xml:lang="en">Fluoride</rdfs:label>
        <rdfs:subClassOf rdf:resource="#AcidRadical"/>
        <rdfs:subClassOf rdf:resource="#Anion"/>
        <rdfs:subClassOf rdf:resource="#F"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">-1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Fe -->

    <owl:Class rdf:about="#Fe">
        <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Fe_2plus -->

    <owl:Class rdf:about="#Fe_2plus">
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Fe"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                        <owl:hasValue rdf:datatype="&xsd;int">3</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Fe_3plus -->

    <owl:Class rdf:about="#Fe_3plus">
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf rdf:resource="#Fe"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#FerricChloride -->

    <owl:Class rdf:about="#FerricChloride">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Cl_1minus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">3</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Fe_3plus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="&xsd;string">FeCl3</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#FerrousChloride -->

    <owl:Class rdf:about="#FerrousChloride">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Cl_1minus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">2</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#Fe_2plus"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="&xsd;string">FeCl2</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#FerrousOxide -->

    <owl:Class rdf:about="#FerrousOxide">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <rdfs:comment rdf:datatype="&xsd;string">FeO</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Glucose -->

    <owl:Class rdf:about="#Glucose">
        <rdfs:subClassOf rdf:resource="#Molecule"/>
        <owl:disjointWith rdf:resource="#HydrogenChloride"/>
        <owl:disjointWith rdf:resource="#Methan"/>
        <owl:disjointWith rdf:resource="#PyridylGlycol"/>
        <owl:disjointWith rdf:resource="#SodiumChloride"/>
        <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
        <owl:disjointWith rdf:resource="#Water"/>
        <rdfs:comment rdf:datatype="&xsd;string">C6h12O6</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#H -->

    <owl:Class rdf:about="#H">
        <rdfs:label xml:lang="en">Hydrogen</rdfs:label>
        <rdfs:subClassOf rdf:resource="#OtherNonMetal"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberOfProtons"/>
                <owl:hasValue rdf:datatype="&xsd;int">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#H_1plus -->

    <owl:Class rdf:about="#H_1plus">
        <rdfs:label rdf:datatype="&xsd;string">H+</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf rdf:resource="#H"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Halogen -->

    <owl:Class rdf:about="#Halogen">
        <rdfs:subClassOf rdf:resource="#NonMetal"/>
        <owl:disjointWith rdf:resource="#Lanthanide"/>
        <owl:disjointWith rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#He -->

    <owl:Class rdf:about="#He">
