<?xml version="1.0"?>


<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY swrl "http://www.w3.org/2003/11/swrl#" >
    <!ENTITY swrlb "http://www.w3.org/2003/11/swrlb#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY owl2xml "http://www.w3.org/2006/12/owl2-xml#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY protege "http://protege.stanford.edu/plugins/owl/protege#" >
    <!ENTITY xsp "http://www.owl-ontologies.com/2005/08/07/xsp.owl#" >
    <!ENTITY swrla "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#" >
    <!ENTITY sqwrl "http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl#" >
    <!ENTITY chemistry "http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#" >
]>


<rdf:RDF xmlns="http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#"
     xml:base="http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
     xmlns:sqwrl="http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:chemistry="http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">
    <owl:Ontology rdf:about="">
        <owl:versionInfo rdf:datatype="&xsd;string">1.0</owl:versionInfo>
        <rdfs:comment rdf:datatype="&xsd;string"
            >This ontology is intended as an incomplete representation of molecules. It is for tutoring purpose. It is heavily inspired from ChEBI (http://www.ebi.ac.uk/chebi/). As usual, the good stuff comes from them; the errors and over-simplifications are ours.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#actsOn -->

    <owl:ObjectProperty rdf:about="#actsOn">
        <rdfs:domain rdf:resource="#BiologicalProcess"/>
        <rdfs:range rdf:resource="#Molecule"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#creationOf -->

    <owl:ObjectProperty rdf:about="#creationOf">
        <rdfs:domain rdf:resource="#BiologicalProcess"/>
        <rdfs:range rdf:resource="#Molecule"/>
        <rdfs:subPropertyOf rdf:resource="#actsOn"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#destructionOf -->

    <owl:ObjectProperty rdf:about="#destructionOf">
        <rdfs:domain rdf:resource="#BiologicalProcess"/>
        <rdfs:range rdf:resource="#Molecule"/>
        <rdfs:subPropertyOf rdf:resource="#actsOn"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasComponent -->

    <owl:ObjectProperty rdf:about="#hasComponent">
        <rdfs:comment rdf:datatype="&xsd;string"
            >Th&#224;nh ph&#7847;n c&#7911;a m&#7897;t ch&#7845;t ho&#7863;c Ion</rdfs:comment>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Ion"/>
                    <rdf:Description rdf:about="#Molecule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasDirectPart -->

    <owl:ObjectProperty rdf:about="#hasDirectPart">
        <rdfs:subPropertyOf rdf:resource="#hasPart"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasPart -->

    <owl:ObjectProperty rdf:about="#hasPart">
        <rdf:type rdf:resource="&owl;TransitiveProperty"/>
        <rdfs:range rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:domain rdf:resource="#PhysicalMaterialEntity"/>
        <owl:inverseOf rdf:resource="#isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasProduct -->

    <owl:ObjectProperty rdf:about="#hasProduct">
        <rdfs:range rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:domain rdf:resource="#Reaction"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasReactant -->

    <owl:ObjectProperty rdf:about="#hasReactant"/>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#isDirectPartOf -->

    <owl:ObjectProperty rdf:about="#isDirectPartOf">
        <rdfs:domain rdf:resource="#PhysicalMaterialEntity"/>
        <owl:inverseOf rdf:resource="#hasDirectPart"/>
        <rdfs:subPropertyOf rdf:resource="#isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#isPartOf -->

    <owl:ObjectProperty rdf:about="#isPartOf">
        <rdfs:range rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:domain rdf:resource="#PhysicalMaterialEntity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#joinWith -->

    <owl:ObjectProperty rdf:about="#joinWith">
        <rdf:type rdf:resource="&owl;TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#produces -->

    <owl:ObjectProperty rdf:about="#produces">
        <rdf:type rdf:resource="&owl;TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasFoation -->

    <owl:DatatypeProperty rdf:about="#hasFoation"/>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasFormula -->

    <owl:DatatypeProperty rdf:about="#hasFormula">
        <rdfs:comment rdf:datatype="&xsd;string"></rdfs:comment>
        <rdfs:domain rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:range rdf:resource="&rdfs;Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasName -->

    <owl:DatatypeProperty rdf:about="#hasName">
        <rdfs:domain rdf:resource="#PhysicalMaterialEntity"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberAtomic -->

    <owl:DatatypeProperty rdf:about="#hasNumberAtomic">
        <rdfs:comment rdf:datatype="&xsd;string">Nguy&#234;n t&#7917; kh&#7889;i</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberElectrovalency -->

    <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency">
        <rdfs:domain rdf:resource="#Ion"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberOfAtomics -->

    <owl:DatatypeProperty rdf:about="#hasNumberOfAtomics">
        <rdfs:domain rdf:resource="#Atom"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberOfElectrons -->

    <owl:DatatypeProperty rdf:about="#hasNumberOfElectrons"/>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberOfNeutrons -->

    <owl:DatatypeProperty rdf:about="#hasNumberOfNeutrons">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#ChemicalElement"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasNumberOfProtons -->

    <owl:DatatypeProperty rdf:about="#hasNumberOfProtons">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#ChemicalElement"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#hasOxidationStates -->

    <owl:DatatypeProperty rdf:about="#hasOxidationStates">
        <rdfs:comment rdf:datatype="&xsd;string">S&#7889; oxy h&#243;a.</rdfs:comment>
        <rdfs:domain rdf:resource="#Atom"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Acid -->

    <owl:Class rdf:about="#Acid">
        <rdfs:subClassOf rdf:resource="#Compound"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#AcidRadical -->

    <owl:Class rdf:about="#AcidRadical">
        <rdfs:subClassOf rdf:resource="#Anion"/>
        <rdfs:comment rdf:datatype="&xsd;string">G&#7889;c axit</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#AcidixOxide -->

    <owl:Class rdf:about="#AcidixOxide">
        <rdfs:subClassOf rdf:resource="#Oxide"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Actinide -->

    <owl:Class rdf:about="#Actinide">
        <rdfs:subClassOf rdf:resource="#Metal"/>
        <owl:disjointWith rdf:resource="#AlkaliMetal"/>
        <owl:disjointWith rdf:resource="#AlkalineEarthMetal"/>
        <owl:disjointWith rdf:resource="#Halogen"/>
        <owl:disjointWith rdf:resource="#Lanthanide"/>
        <owl:disjointWith rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ag -->

    <owl:Class rdf:about="#Ag">
        <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Al -->

    <owl:Class rdf:about="#Al">
        <rdfs:label xml:lang="en">Aluminium</rdfs:label>
        <rdfs:subClassOf rdf:resource="#SemiMetal"/>
        <owl:disjointWith rdf:resource="#Ar"/>
        <owl:disjointWith rdf:resource="#B"/>
        <owl:disjointWith rdf:resource="#Be"/>
        <owl:disjointWith rdf:resource="#C"/>
        <owl:disjointWith rdf:resource="#Cl"/>
        <owl:disjointWith rdf:resource="#F"/>
        <owl:disjointWith rdf:resource="#H"/>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Al_3plus -->

    <owl:Class rdf:about="#Al_3plus">
        <rdfs:label>Al 3+</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Al"/>
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Aldohexose -->

    <owl:Class rdf:about="#Aldohexose">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Aldose"/>
                    <rdf:Description rdf:about="#Hexose"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Aldose -->

    <owl:Class rdf:about="#Aldose">
        <rdfs:subClassOf rdf:resource="#Monosaccharide"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#AlkaliMetal -->

    <owl:Class rdf:about="#AlkaliMetal">
        <rdfs:subClassOf rdf:resource="#Metal"/>
        <owl:disjointWith rdf:resource="#AlkalineEarthMetal"/>
        <owl:disjointWith rdf:resource="#Halogen"/>
        <owl:disjointWith rdf:resource="#Lanthanide"/>
        <owl:disjointWith rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#AlkalineEarthMetal -->

    <owl:Class rdf:about="#AlkalineEarthMetal">
        <rdfs:subClassOf rdf:resource="#Metal"/>
        <owl:disjointWith rdf:resource="#Halogen"/>
        <owl:disjointWith rdf:resource="#Lanthanide"/>
        <owl:disjointWith rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Anion -->

    <owl:Class rdf:about="#Anion">
        <rdfs:subClassOf rdf:resource="#Ion"/>
        <owl:disjointWith rdf:resource="#Cation"/>
        <rdfs:comment xml:lang="wikipedia"
            >Anions are negatively charged ions, formed when an atom gains electrons in a reaction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ar -->

    <owl:Class rdf:about="#Ar">
        <rdfs:label xml:lang="en">Argon</rdfs:label>
        <rdfs:subClassOf rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#B"/>
        <owl:disjointWith rdf:resource="#Be"/>
        <owl:disjointWith rdf:resource="#C"/>
        <owl:disjointWith rdf:resource="#Cl"/>
        <owl:disjointWith rdf:resource="#F"/>
        <owl:disjointWith rdf:resource="#H"/>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Atom -->

    <owl:Class rdf:about="#Atom">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberOfProtons"/>
                <owl:minCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Au -->

    <owl:Class rdf:about="#Au">
        <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#B -->

    <owl:Class rdf:about="#B">
        <rdfs:label xml:lang="en">Boron</rdfs:label>
        <rdfs:subClassOf rdf:resource="#SemiMetal"/>
        <owl:disjointWith rdf:resource="#Be"/>
        <owl:disjointWith rdf:resource="#C"/>
        <owl:disjointWith rdf:resource="#Cl"/>
        <owl:disjointWith rdf:resource="#F"/>
        <owl:disjointWith rdf:resource="#H"/>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ba -->

    <owl:Class rdf:about="#Ba">
        <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Base -->

    <owl:Class rdf:about="#Base">
        <rdfs:subClassOf rdf:resource="#Compound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasComponent"/>
                <owl:onClass rdf:resource="#OH_1minus"/>
                <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Be -->

    <owl:Class rdf:about="#Be">
        <rdfs:label xml:lang="en">Beryllium</rdfs:label>
        <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
        <owl:disjointWith rdf:resource="#C"/>
        <owl:disjointWith rdf:resource="#Cl"/>
        <owl:disjointWith rdf:resource="#F"/>
        <owl:disjointWith rdf:resource="#H"/>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Be_2plus -->

    <owl:Class rdf:about="#Be_2plus">
        <rdfs:subClassOf rdf:resource="#Be"/>
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#BiologicalProcess -->

    <owl:Class rdf:about="#BiologicalProcess"/>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Br -->

    <owl:Class rdf:about="#Br">
        <rdfs:subClassOf rdf:resource="#Halogen"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#C -->

    <owl:Class rdf:about="#C">
        <rdfs:label xml:lang="en">Carbon</rdfs:label>
        <rdfs:subClassOf rdf:resource="#OtherNonMetal"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberOfProtons"/>
                <owl:hasValue rdf:datatype="&xsd;integer">6</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="#Cl"/>
        <owl:disjointWith rdf:resource="#F"/>
        <owl:disjointWith rdf:resource="#H"/>
        <owl:disjointWith rdf:resource="#He"/>
        <owl:disjointWith rdf:resource="#Li"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ca -->

    <owl:Class rdf:about="#Ca">
        <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ca_2plus -->

    <owl:Class rdf:about="#Ca_2plus">
        <rdfs:subClassOf rdf:resource="#Ca"/>
        <rdfs:subClassOf rdf:resource="#Cation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasNumberElectrovalency"/>
                <owl:hasValue rdf:datatype="&xsd;int">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Carbohydrate -->

    <owl:Class rdf:about="#Carbohydrate">
        <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Cation -->

    <owl:Class rdf:about="#Cation">
        <rdfs:subClassOf rdf:resource="#Ion"/>
        <rdfs:comment xml:lang="wikipedia"
            >Cations are positively charged ions, formed when an atom loses electrons in a reaction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#ChemicalElement -->

    <owl:Class rdf:about="#ChemicalElement">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:comment xml:lang="en"
            >A chemical element is a type of atom that is distinguished by its atomic number; that is, by the number of protons in its nucleus</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Cl -->

    <owl:Class rdf:about="#Cl">
        <rdfs:label xml:lang="en">Chlorine</rdfs:label>
