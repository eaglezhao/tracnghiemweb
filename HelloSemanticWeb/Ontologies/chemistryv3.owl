<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
    xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sqwrl="http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl#"
    xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:chemistry="http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#"
    xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
  xml:base="http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl">
  <owl:Ontology rdf:about="">
    <owl:imports rdf:resource="http://sqwrl.stanford.edu/ontologies/built-ins/3.4/sqwrl.owl"/>
    <owl:imports rdf:resource="http://swrl.stanford.edu/ontologies/3.3/swrla.owl"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >This ontology is intended as an incomplete representation of molecules. It is for tutoring purpose. It is heavily inspired from ChEBI (http://www.ebi.ac.uk/chebi/). As usual, the good stuff comes from them; the errors and over-simplifications are ours.</rdfs:comment>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >1.0</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:ID="He">
    <owl:disjointWith>
      <owl:Class rdf:ID="N"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="NobleGas"/>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:ID="Na"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Ne"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Li"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Mg"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="S"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Si"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:ID="hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >2</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:ID="P"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Helium</rdfs:label>
    <owl:disjointWith>
      <owl:Class rdf:ID="O"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:ID="HydrogenChloride">
    <owl:disjointWith>
      <chemistry:Water rdf:ID="Water">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >H2O</rdfs:comment>
        <rdf:type>
          <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
        </rdf:type>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:subClassOf>
          <owl:Class rdf:ID="Molecule"/>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
          <owl:Restriction>
            <owl:onProperty>
              <owl:ObjectProperty rdf:ID="hasComponent"/>
            </owl:onProperty>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >2</owl:minCardinality>
            <owl:valuesFrom>
              <owl:Class rdf:ID="H"/>
            </owl:valuesFrom>
          </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
          <owl:Restriction>
            <owl:valuesFrom>
              <owl:Class rdf:about="#O"/>
            </owl:valuesFrom>
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="#hasComponent"/>
            </owl:onProperty>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >1</owl:minCardinality>
          </owl:Restriction>
        </rdfs:subClassOf>
      </chemistry:Water>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="SodiumHydroxide"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="SodiumChloride"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="PyridylGlycol"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Methan"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Molecule"/>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >HCl</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:ID="Cation">
    <rdfs:comment xml:lang="wikipedia">Cations are positively charged ions, formed when an atom loses electrons in a reaction.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Ion"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Oxide">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Compound"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Mn">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="TransitionMetal"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="He_2plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:ID="hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >2</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#He"/>
    <rdfs:subClassOf rdf:resource="#Cation"/>
  </owl:Class>
  <owl:Class rdf:ID="Be_2plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >2</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Be"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#NobleGas">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="NonMetal"/>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:about="#TransitionMetal"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="OtherNonMetal"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:ID="Hexose">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Monosaccharide"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#P">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#OtherNonMetal"/>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Phosphorus</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Br">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Halogen"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Monosaccharide">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Carbohydrate"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="OrganicCompound">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Compound"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#NonMetal">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Atom"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="ChemicalElement">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="PhysicalMaterialEntity"/>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="en">A chemical element is a type of atom that is distinguished by its atomic number; that is, by the number of protons in its nucleus</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:ID="H_1plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#H"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >H+</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="NucleicAcid">
    <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
  </owl:Class>
  <owl:Class rdf:ID="MetabolicProcess">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="BiologicalProcess"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Ba">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="AlkalineEarthMetal"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="F_1minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-1</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="F"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Anion"/>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Fluoride</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Ca_2plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >2</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Ca"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="AlkaliMetal">
    <owl:disjointWith>
      <owl:Class rdf:about="#TransitionMetal"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#OtherNonMetal"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#NobleGas"/>
    <owl:disjointWith>
      <owl:Class rdf:ID="Lanthanide"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Halogen"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#AlkalineEarthMetal"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Metal"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#H">
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Li"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#O"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#N"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Hydrogen</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:about="#Ne"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Mg"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Na"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#OtherNonMetal"/>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="#He"/>
  </owl:Class>
  <owl:Class rdf:about="#TransitionMetal">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Metal"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="P_3minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-3</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#P"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Anion"/>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Phosphide</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Ne">
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#O"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Neon</rdfs:label>
    <rdfs:subClassOf rdf:resource="#NobleGas"/>
  </owl:Class>
  <owl:Class rdf:about="#O">
    <rdfs:label xml:lang="en">Oxygen</rdfs:label>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#OtherNonMetal"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >8</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Anion">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Ion"/>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="wikipedia">Anions are negatively charged ions, formed when an atom gains electrons in a reaction.</rdfs:comment>
    <owl:disjointWith rdf:resource="#Cation"/>
  </owl:Class>
  <owl:Class rdf:ID="FerricChloride">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Molecule"/>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;
      FeCl3
    &lt;/p&gt;</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#Carbohydrate">
    <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
  </owl:Class>
  <owl:Class rdf:ID="Mg_2plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >2</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Mg"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
  </owl:Class>
  <owl:Class rdf:about="#Atom">
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#N">
    <owl:disjointWith rdf:resource="#P"/>
    <rdfs:label xml:lang="en">Nitrogen</rdfs:label>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#OtherNonMetal"/>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="#Ne"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >7</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:about="#Na"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:about="#Ion">
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
    <rdfs:comment xml:lang="en">An ion is an atom or molecule which has lost or gained one or more valence electrons, giving it a positive or negative electrical charge.</rdfs:comment>
    <rdfs:comment xml:lang="chebi">An ion is a molecular structure having a net electric charge</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:ID="Transport">
    <rdfs:subClassOf rdf:resource="#BiologicalProcess"/>
  </owl:Class>
  <owl:Class rdf:about="#Methan">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Molecule"/>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >CH4</rdfs:comment>
    <owl:disjointWith rdf:resource="#Water"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#SodiumHydroxide"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#SodiumChloride"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#PyridylGlycol"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:about="#OtherNonMetal">
    <owl:disjointWith rdf:resource="#TransitionMetal"/>
    <rdfs:subClassOf rdf:resource="#NonMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="MoleculeContainingMetal">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Molecule"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Mg">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#AlkalineEarthMetal"/>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Na"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Magnesium</rdfs:label>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith rdf:resource="#O"/>
  </owl:Class>
  <owl:Class rdf:about="#SodiumHydroxide">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >NaOH</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Molecule"/>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="#Water"/>
  </owl:Class>
  <owl:Class rdf:ID="SemiMetal">
    <rdfs:subClassOf rdf:resource="#Atom"/>
  </owl:Class>
  <owl:Class rdf:about="#F">
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#He"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Li"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#O"/>
    <rdfs:label xml:lang="en">Fluorine</rdfs:label>
    <owl:disjointWith rdf:resource="#N"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Halogen"/>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="#H"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Na"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:about="#Molecule">
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
    <rdfs:comment xml:lang="wikipedia">A molecule is a sufficiently stable electrically neutral group of at least two atoms in a definite arrangement held together by very strong chemical bonds . It can also be defined as a unit of two or more atoms held together by covalent bonds.</rdfs:comment>
    <rdfs:comment xml:lang="chebi">A molecule is an electrically neutral entity consisting of more than one atom.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:ID="Ag">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="MetalicIon">
    <rdfs:subClassOf rdf:resource="#Cation"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Ion"/>
          <owl:Class rdf:about="#Metal"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#Metal">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >AlkaliMetal or AlkalineEarthMetal or TransitionMetal or SemiMetal or Actinide or Lanthanide</rdfs:comment>
    <owl:disjointWith rdf:resource="#NonMetal"/>
    <rdfs:subClassOf rdf:resource="#Atom"/>
  </owl:Class>
  <owl:Class rdf:about="#AlkalineEarthMetal">
    <owl:disjointWith rdf:resource="#TransitionMetal"/>
    <owl:disjointWith rdf:resource="#OtherNonMetal"/>
    <owl:disjointWith rdf:resource="#NobleGas"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Lanthanide"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Halogen"/>
    </owl:disjointWith>
    <rdfs:subClassOf rdf:resource="#Metal"/>
  </owl:Class>
  <owl:Class rdf:ID="L-glucose">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Glucose"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Halogen">
    <owl:disjointWith rdf:resource="#TransitionMetal"/>
    <owl:disjointWith rdf:resource="#OtherNonMetal"/>
    <owl:disjointWith rdf:resource="#NobleGas"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Lanthanide"/>
    </owl:disjointWith>
    <rdfs:subClassOf rdf:resource="#NonMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Aldohexose">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:ID="Aldose"/>
          <owl:Class rdf:about="#Hexose"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Reaction"/>
  <owl:Class rdf:about="#Na">
    <rdfs:label xml:lang="en">Sodium</rdfs:label>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Actinide">
    <rdfs:subClassOf rdf:resource="#Metal"/>
    <owl:disjointWith rdf:resource="#TransitionMetal"/>
    <owl:disjointWith rdf:resource="#OtherNonMetal"/>
    <owl:disjointWith rdf:resource="#NobleGas"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Lanthanide"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#Halogen"/>
    <owl:disjointWith rdf:resource="#AlkalineEarthMetal"/>
    <owl:disjointWith rdf:resource="#AlkaliMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Ar">
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith>
      <owl:Class rdf:ID="B"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#Be"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Argon</rdfs:label>
    <owl:disjointWith rdf:resource="#H"/>
    <rdfs:subClassOf rdf:resource="#NobleGas"/>
    <owl:disjointWith rdf:resource="#He"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Li"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="Cl"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#F"/>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith>
      <owl:Class rdf:ID="C"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
  </owl:Class>
  <owl:Class rdf:ID="Li_1plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Li"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
  </owl:Class>
  <owl:Class rdf:ID="Cs">
    <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Fe">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:about="#Aldose">
    <rdfs:subClassOf rdf:resource="#Monosaccharide"/>
  </owl:Class>
  <owl:Class rdf:ID="S_2minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-2</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#S"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Anion"/>
    <rdfs:label xml:lang="en">Sulfide</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Base">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:minCardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
        <owl:valuesFrom>
          <owl:Class rdf:ID="OH_1minus"/>
        </owl:valuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Compound"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Al_3plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >3</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Cation"/>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Al"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#C">
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#O"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >6</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#OtherNonMetal"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#H"/>
    <rdfs:label xml:lang="en">Carbon</rdfs:label>
    <owl:disjointWith rdf:resource="#He"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Cl"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#F"/>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Li"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:about="#Ca">
    <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Zn">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="PolyatomicIon">
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Ion"/>
          <owl:Class rdf:about="#Molecule"/>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
  </owl:Class>
  <owl:Class rdf:about="#Glucose">
    <rdfs:subClassOf rdf:resource="#Molecule"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >C6h12O6</rdfs:comment>
    <owl:disjointWith rdf:resource="#Water"/>
    <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#SodiumChloride"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:about="#PyridylGlycol"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#Methan"/>
    <owl:disjointWith rdf:resource="#HydrogenChloride"/>
  </owl:Class>
  <owl:Class rdf:ID="AcidixOxide">
    <rdfs:subClassOf rdf:resource="#Oxide"/>
  </owl:Class>
  <owl:Class rdf:about="#Li">
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#S"/>
    </owl:disjointWith>
    <rdfs:label xml:lang="en">Lithium</rdfs:label>
    <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#Ne"/>
  </owl:Class>
  <owl:Class rdf:about="#S">
    <rdfs:label xml:lang="en">Sulfur</rdfs:label>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="#hasNumberOfProtons"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >16</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#OtherNonMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Cr">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Hg">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="K">
    <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="O_2minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-2</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#O"/>
    <rdfs:subClassOf rdf:resource="#Anion"/>
    <rdfs:label xml:lang="en">Oxide</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="MonoatomicIon">
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Atom"/>
          <owl:Class rdf:about="#Ion"/>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Be">
    <owl:disjointWith>
      <owl:Class rdf:about="#Cl"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#Si"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#C"/>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith rdf:resource="#H"/>
    <rdfs:label xml:lang="en">Beryllium</rdfs:label>
    <owl:disjointWith rdf:resource="#S"/>
    <owl:disjointWith rdf:resource="#He"/>
    <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
    <owl:disjointWith rdf:resource="#Li"/>
    <owl:disjointWith rdf:resource="#F"/>
  </owl:Class>
  <owl:Class rdf:ID="Cl_1minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-1</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Cl"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Anion"/>
    <rdfs:label xml:lang="en">Chloride</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Lipid">
    <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
  </owl:Class>
  <owl:Class rdf:ID="Cu">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Na_1plus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Na"/>
    <rdfs:subClassOf rdf:resource="#Cation"/>
  </owl:Class>
  <owl:Class rdf:ID="Rb">
    <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="D-glucose">
    <rdfs:subClassOf rdf:resource="#Glucose"/>
  </owl:Class>
  <owl:Class rdf:about="#Compound">
    <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
  </owl:Class>
  <owl:Class rdf:ID="Ti">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="SO4_2minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >4</owl:cardinality>
        <owl:valuesFrom rdf:resource="#O"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:valuesFrom rdf:resource="#S"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Anion"/>
  </owl:Class>
  <owl:Class rdf:about="#OH_1minus">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-1</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:valuesFrom rdf:resource="#H"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:valuesFrom rdf:resource="#O"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Anion"/>
  </owl:Class>
  <owl:Class rdf:about="#Si">
    <rdfs:label xml:lang="en">Silicon</rdfs:label>
    <rdfs:subClassOf rdf:resource="#SemiMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="Au">
    <rdfs:subClassOf rdf:resource="#TransitionMetal"/>
  </owl:Class>
  <owl:Class rdf:about="#Cl">
    <owl:disjointWith rdf:resource="#Li"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#Si"/>
    <owl:disjointWith rdf:resource="#H"/>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#F"/>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#N"/>
    <rdfs:subClassOf rdf:resource="#Halogen"/>
    <rdfs:label xml:lang="en">Chlorine</rdfs:label>
    <owl:disjointWith rdf:resource="#S"/>
    <owl:disjointWith rdf:resource="#He"/>
  </owl:Class>
  <owl:Class rdf:ID="Acid">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasComponent"/>
        </owl:onProperty>
        <owl:valuesFrom rdf:resource="#H_1plus"/>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Compound"/>
  </owl:Class>
  <owl:Class rdf:about="#Lanthanide">
    <rdfs:subClassOf rdf:resource="#Metal"/>
    <owl:disjointWith rdf:resource="#TransitionMetal"/>
    <owl:disjointWith rdf:resource="#OtherNonMetal"/>
    <owl:disjointWith rdf:resource="#NobleGas"/>
  </owl:Class>
  <owl:Class rdf:about="#Al">
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#Cl"/>
    <owl:disjointWith rdf:resource="#Ar"/>
    <owl:disjointWith rdf:resource="#O"/>
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#He"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <owl:disjointWith rdf:resource="#H"/>
    <owl:disjointWith rdf:resource="#Li"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#B"/>
    </owl:disjointWith>
    <owl:disjointWith rdf:resource="#Be"/>
    <owl:disjointWith rdf:resource="#C"/>
    <owl:disjointWith rdf:resource="#S"/>
    <rdfs:subClassOf rdf:resource="#SemiMetal"/>
    <owl:disjointWith rdf:resource="#Si"/>
    <owl:disjointWith rdf:resource="#F"/>
    <owl:disjointWith rdf:resource="#N"/>
    <rdfs:label xml:lang="en">Aluminium</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Sr">
    <rdfs:subClassOf rdf:resource="#AlkalineEarthMetal"/>
  </owl:Class>
  <owl:Class rdf:ID="N_3minus">
    <rdfs:label xml:lang="en">Nitride</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >-3</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasNumberElectrovalency"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#N"/>
    <rdfs:subClassOf rdf:resource="#Anion"/>
  </owl:Class>
  <owl:Class rdf:ID="I">
    <rdfs:subClassOf rdf:resource="#Halogen"/>
  </owl:Class>
  <owl:Class rdf:ID="Protein">
    <rdfs:subClassOf rdf:resource="#OrganicCompound"/>
  </owl:Class>
  <owl:Class rdf:about="#B">
    <owl:disjointWith rdf:resource="#P"/>
    <owl:disjointWith rdf:resource="#Na"/>
    <owl:disjointWith rdf:resource="#Cl"/>
    <owl:disjointWith rdf:resource="#Be"/>
    <owl:disjointWith rdf:resource="#N"/>
    <owl:disjointWith rdf:resource="#S"/>
    <owl:disjointWith rdf:resource="#Ne"/>
    <owl:disjointWith rdf:resource="#Mg"/>
    <rdfs:label xml:lang="en">Boron</rdfs:label>
    <owl:disjointWith rdf:resource="#H"/>
    <owl:disjointWith rdf:resource="#C"/>
    <rdfs:subClassOf rdf:resource="#SemiMetal"/>
    <owl:disjointWith rdf:resource="#He"/>
    <owl:disjointWith rdf:resource="#Li"/>
    <owl:disjointWith rdf:resource="#F"/>
    <owl:disjointWith rdf:resource="#Si"/>
    <owl:disjointWith rdf:resource="#O"/>
  </owl:Class>
  <owl:Class rdf:about="#PyridylGlycol">
    <owl:disjointWith rdf:resource="#Water"/>
    <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
    <owl:disjointWith>
      <owl:Class rdf:about="#SodiumChloride"/>
    </owl:disjointWith>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >C24H24N4O4</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Molecule"/>
  </owl:Class>
  <owl:Class rdf:about="#SodiumChloride">
    <rdfs:subClassOf rdf:resource="#Molecule"/>
    <owl:disjointWith rdf:resource="#Water"/>
    <owl:disjointWith rdf:resource="#SodiumHydroxide"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >NaCl</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:ID="hasReactant"/>
  <owl:ObjectProperty rdf:ID="hasProduct">
    <rdfs:domain rdf:resource="#Reaction"/>
    <rdfs:range rdf:resource="#PhysicalMaterialEntity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasComponent">
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Molecule"/>
          <owl:Class rdf:about="#Ion"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
