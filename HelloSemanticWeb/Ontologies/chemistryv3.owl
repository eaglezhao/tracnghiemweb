    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Ion -->

    <owl:Class rdf:about="#Ion">
        <rdfs:subClassOf rdf:resource="#PhysicalMaterialEntity"/>
        <rdfs:comment xml:lang="chebi"
            >An ion is a molecular structure having a net electric charge</rdfs:comment>
        <rdfs:comment xml:lang="en"
            >An ion is an atom or molecule which has lost or gained one or more valence electrons, giving it a positive or negative electrical charge.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#K -->

    <owl:Class rdf:about="#K">
        <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#L-glucose -->

    <owl:Class rdf:about="#L-glucose">
        <rdfs:subClassOf rdf:resource="#Glucose"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Lanthanide -->

    <owl:Class rdf:about="#Lanthanide">
        <rdfs:subClassOf rdf:resource="#Metal"/>
        <owl:disjointWith rdf:resource="#NobleGas"/>
        <owl:disjointWith rdf:resource="#OtherNonMetal"/>
        <owl:disjointWith rdf:resource="#TransitionMetal"/>
    </owl:Class>
    


    <!-- http://www.ea3888.univ-rennes1.fr/dameron/ontology/chemistry.owl#Li -->

    <owl:Class rdf:about="#Li">
        <rdfs:label xml:lang="en">Lithium</rdfs:label>
        <rdfs:subClassOf rdf:resource="#AlkaliMetal"/>
        <owl:disjointWith rdf:resource="#Mg"/>
        <owl:disjointWith rdf:resource="#N"/>
        <owl:disjointWith rdf:resource="#Na"/>
        <owl:disjointWith rdf:resource="#Ne"/>
        <owl:disjointWith rdf:resource="#O"/>
        <owl:disjointWith rdf:resource="#P"/>
        <owl:disjointWith rdf:resource="#S"/>
        <owl:disjointWith rdf:resource="#Si"/>
    </owl:Class>
    


