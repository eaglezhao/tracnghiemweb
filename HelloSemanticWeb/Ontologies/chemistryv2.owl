      <owl:TransitiveProperty rdf:ID="hasPart"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasProductIs"/>
  <owl:ObjectProperty rdf:about="#actsOn">
