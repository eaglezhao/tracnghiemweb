  </owl:FunctionalProperty>
  <swrl:Imp rdf:about="http://www.ea3888.univ-rennes1.fr/dameron/ontology/nullRule-4">
    <swrl:head>
      <swrl:AtomList>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:propertyPredicate rdf:resource="#produces"/>
            <swrl:argument2>
              <swrl:Variable rdf:about="http://www.ea3888.univ-rennes1.fr/dameron/ontology/y"/>
            </swrl:argument2>
            <swrl:argument1>
              <swrl:Variable rdf:about="http://www.ea3888.univ-rennes1.fr/dameron/ontology/reaction"/>
            </swrl:argument1>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </swrl:AtomList>
    </swrl:head>
    <swrl:body>
      <swrl:AtomList>
        <rdf:rest>
          <swrl:AtomList>
            <rdf:first>
              <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="#produces"/>
                <swrl:argument1>
                  <swrl:Variable rdf:about="http://www.ea3888.univ-rennes1.fr/dameron/ontology/x"/>
                </swrl:argument1>
                <swrl:argument2 rdf:resource="http://www.ea3888.univ-rennes1.fr/dameron/ontology/y"/>
              </swrl:IndividualPropertyAtom>
            </rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
          </swrl:AtomList>
        </rdf:rest>
        <rdf:first>
          <swrl:IndividualPropertyAtom>
            <swrl:propertyPredicate rdf:resource="#hasProduct"/>
            <swrl:argument1 rdf:resource="http://www.ea3888.univ-rennes1.fr/dameron/ontology/reaction"/>
            <swrl:argument2 rdf:resource="http://www.ea3888.univ-rennes1.fr/dameron/ontology/x"/>
          </swrl:IndividualPropertyAtom>
        </rdf:first>
      </swrl:AtomList>
    </swrl:body>
  </swrl:Imp>
  <owl:Thing rdf:ID="Reaction_3">
    <rdf:type rdf:resource="#Reaction"/>
    <chemistry:hasReactant>
      <owl:Thing rdf:ID="Hydrogen">
        <rdfs:subClassOf rdf:resource="#NamedMolecule"/>
        <rdfs:subClassOf rdf:resource="#MoleculeContainingHydrogen"/>
        <rdf:type rdf:resource="#Hydrogen"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
      </owl:Thing>
    </chemistry:hasReactant>
    <chemistry:hasReactant>
      <owl:Thing rdf:ID="FerrousOxide">
        <rdfs:subClassOf rdf:resource="#MoleculeContainingOxygen"/>
        <rdfs:subClassOf rdf:resource="#MoleculeContainingMetal"/>
        <rdf:type rdf:resource="#FerrousOxide"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >FeO</rdfs:comment>
      </owl:Thing>
    </chemistry:hasReactant>
    <chemistry:hasProduct rdf:resource="#Water"/>
    <chemistry:hasProduct>
      <owl:Thing rdf:ID="Iron">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >Fe</rdfs:comment>
        <rdf:type rdf:resource="#Iron"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
        <rdfs:subClassOf rdf:resource="#NamedMolecule"/>
        <rdfs:subClassOf rdf:resource="#MoleculeContainingMetal"/>
      </owl:Thing>
    </chemistry:hasProduct>
  </owl:Thing>
  <chemistry:Reaction rdf:ID="Reaction_2">
    <chemistry:hasProduct rdf:resource="#Hydrogen"/>
