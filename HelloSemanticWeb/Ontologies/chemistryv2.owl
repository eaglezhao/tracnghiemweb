        <rdfs:subClassOf rdf:resource="#NamedMolecule"/>
        <rdfs:subClassOf rdf:resource="#MoleculeContainingOxygen"/>
      </chemistry:Oxygen>
    </chemistry:hasReactant>
    <chemistry:hasReactant rdf:resource="#Iron"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </chemistry:Reaction>
  <chemistry:MoleculeContainingMetal rdf:ID="MoleculeContainingMetal_5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </chemistry:MoleculeContainingMetal>
  <owl:Thing rdf:ID="Reaction_4">
    <chemistry:hasReactant>
      <owl:Thing rdf:ID="Rust">
        <rdfs:subClassOf rdf:resource="#MoleculeContainingOxygen"/>
        <rdfs:subClassOf rdf:resource="#MoleculeContainingMetal"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
