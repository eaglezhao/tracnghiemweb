        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
      </owl:Thing>
    </chemistry:hasProduct>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <chemistry:hasReactant rdf:resource="#Iron"/>
    <chemistry:hasReactant>
      <chemistry:HydrogenChloride rdf:ID="HydroChloride">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
      </chemistry:HydrogenChloride>
    </chemistry:hasReactant>
  </chemistry:Reaction>
  <chemistry:Reaction rdf:ID="Reaction-FeO">
    <chemistry:hasProduct rdf:resource="#FerrousOxide"/>
    <chemistry:hasReactant>
      <chemistry:Oxygen rdf:ID="Oxygen">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
