      </owl:Thing>
    </chemistry:hasReactant>
    <chemistry:hasReactant rdf:resource="#HydroChloride"/>
    <rdf:type rdf:resource="#Reaction"/>
    <chemistry:hasProduct rdf:resource="#Water"/>
    <chemistry:hasProduct>
      <owl:Thing rdf:ID="FerricChloride_1">
        <rdf:type rdf:resource="#FerricChloride"/>
      </owl:Thing>
    </chemistry:hasProduct>
  </owl:Thing>
  <swrl:Imp rdf:about="http://www.ea3888.univ-rennes1.fr/dameron/ontology/nullRule-1">
